model CommunityPost {
  id           String              @id @default(cuid())
  userId       String              @map("user_id")
  title        String?             @db.VarChar(255)
  posterUrl    String?             @map("poster_url") @db.VarChar(500)
  description  String
  location     String?             @db.VarChar(500)
  startTime    DateTime?           @map("start_time")
  endTime      DateTime?           @map("end_time")
  tag          EventTag?
  status       CommunityPostStatus @default(pending)
  approvedById String?             @map("approved_by_id")
  approvedAt   DateTime?           @map("approved_at")
  rejectedAt   DateTime?           @map("rejected_at")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  deletedAt    DateTime?
  approvedBy   User?               @relation("PostApprover", fields: [approvedById], references: [id])
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  favorites Favorite[]

  @@index([userId])
  @@index([status])
  @@index([tag])
  @@map("community_post")
}

model Participant {
  id            String             @id @default(cuid())
  participantId String             @map("participant_id")
  eventId       String             @map("event_id")
  status        RegistrationStatus @default(pending)
  checkedInAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @default(now()) @updatedAt
  confirmedAt   DateTime?          @map("confirmed_at")
  event         Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participant   User               @relation(fields: [participantId], references: [id])

  @@unique([participantId, eventId])
  @@index([participantId])
  @@index([eventId])
  @@index([status])
  @@map("participants")
}
//in app notification
model Notification {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  title     String
  message   String
  readAt    DateTime?
  type      NotificationType
  actionUrl String?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([readAt])
  @@index([type])
  @@index([createdAt])
  @@map("notifications")
}

model Ticket {
  id        String       @id @default(cuid())
  eventId   String       @map("event_id")
  userId    String       @map("user_id")
  code      String       @unique
  status    TicketStatus @default(active)
  issuedAt  DateTime     @default(now())
  scannedBy String?      @map("scanned_by")
  event     Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt     DateTime       @default(now()) @updatedAt

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@index([code])
  @@index([status])
  @@map("tickets")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  endpoint  String   @unique()
  keys      Json
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

}

model Favorite {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  eventId     String? 
  event       Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  postId      String?
  post        CommunityPost? @relation(fields: [postId], references: [id], onDelete: Cascade)

  type        FavoriteType
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([eventId])
  @@index([postId])
    @@unique([userId, eventId])
  @@unique([userId, postId])
}

enum FavoriteType {
  event
  post
}



enum TicketStatus {
  active
  used
  cancelled
}

enum NotificationType {
  event_update
  event_cancelled
  event_accepted
  post_accepted
  reminder
  general
}

enum UserRole {
  user
  moderator
  admin
}


enum EventStatus {
  pending
  approved
  rejected
  cancelled
  demo
}

enum CommunityPostStatus {
  pending
  approved
  rejected
}

enum RegistrationStatus {
  pending
  confirmed
  paid
  cancelled
}

enum EventTag {
  music
  sports
  education
  tech
  business
  art
  food
  culture
  charity
  entertainment
  health
  community
}
