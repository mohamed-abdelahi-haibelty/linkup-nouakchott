generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url    = env("DATABASE_URL")
}

model User {
  id             String          @id
  role           UserRole        @default(user)
  name           String
  email          String          @unique
  avatarUrl      String?         @map("avatar_url")
  phoneNumber    String?         @map("phone_number")
  bio            String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  approvedPosts  CommunityPost[] @relation("PostApprover")
  posts          CommunityPost[]
  approvedEvents Event[]         @relation("EventApprover")
  events         Event[]
  notifications  Notification[]
  registrations  Participant[]
  tickets        Ticket[]
  pushSubscriptions PushSubscription[]
  favorites Favorite[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model Event {
  id            String         @id @default(cuid())
  title         String         @db.VarChar(255)
  slug          String         @db.VarChar(255)
  description   String
  imageUrl      String         @map("image_url") @db.VarChar(500)
  capacity      Int            @default(0)
  price         Float          @default(0) @db.DoublePrecision
  location      String         @db.VarChar(500)
  status        EventStatus    @default(pending)
  contactPhone  String?        @db.VarChar(20)
  startTime     DateTime       @map("start_time")
  endTime       DateTime       @map("end_time")
  isFree        Boolean        @map("is_free")
  tag           EventTag?
  organizerId   String         @map("organizer_id")
  approvedById  String?        @map("approved_by_id")
  approvedAt    DateTime?      @map("approved_at")
  rejectedAt    DateTime?      @map("rejected_at")
  cancelledAt   DateTime?      @map("cancelled_at")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?      @map("deleted_at")
  registrationDeadline DateTime
  //timelineItems TimelineItem[]
  approvedBy    User?          @relation("EventApprover", fields: [approvedById], references: [id])
  organizer     User           @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  participants  Participant[]
  tickets       Ticket[]
  favorites Favorite[]

  @@index([slug])
  @@index([organizerId])
  @@index([status])
  @@index([startTime])
  @@index([tag])
  @@index([location])
  @@map("events")
}

