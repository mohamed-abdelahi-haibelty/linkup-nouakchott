# Neon PostgreSQL. The runtime uses the Neon WebSocket adapter.
DATABASE_URL=postgresql://user:password@your-neon-host/linkup?sslmode=require
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Kinde application credentials. Configure /api/auth/kinde_callback as an allowed callback.
KINDE_CLIENT_ID=
KINDE_CLIENT_SECRET=
KINDE_ISSUER_URL=https://your-tenant.kinde.com
KINDE_SITE_URL=http://localhost:3000
KINDE_POST_LOGIN_REDIRECT_URL=http://localhost:3000/api/auth/session
KINDE_POST_LOGOUT_REDIRECT_URL=http://localhost:3000

# Optional ticket email. Tickets still appear in the app without email delivery.
RESEND_API_KEY=
TICKET_EMAIL_FROM=Linkup Nouakchott <no-reply@your-verified-domain.example>

# Optional browser push notifications.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:support@your-domain.example

# Optional monitoring and analytics.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
